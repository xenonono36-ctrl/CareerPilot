# =============================================
# CareerPilot Backend — Environment Variables
# =============================================
# Copy this file to `.env` and fill in real values.
# Never commit your real `.env` to source control.

# --- Database (PostgreSQL with asyncpg driver) ---
# Local dev:      postgresql+asyncpg://postgres:postgres@localhost:5432/careerpilot
# Railway/Render: postgresql+asyncpg://USER:PASS@HOST:5432/DBNAME
DATABASE_URL=postgresql+asyncpg://careerpilot:careerpilot_secret@localhost:5432/careerpilot
DATABASE_SYNC_URL=postgresql://careerpilot:careerpilot_secret@localhost:5432/careerpilot

# --- Google Gemini AI (https://aistudio.google.com/app/apikey) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Clerk Authentication (https://dashboard.clerk.com) ---
# Frontend uses the publishable key, backend uses the secret key
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here
# Optional — used to verify session tokens via JWKS.
# Dev (default):  https://clerk.dev
# Prod instance:  https://clerk.your-domain.com  (or your Clerk frontend API URL)
CLERK_JWT_ISSUER=https://clerk.dev
# Optional — for Clerk webhooks (user.created / user.updated)
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# --- JSearch Job API (https://rapidapi.com/letscrape/api/jsearch) ---
JSEARCH_API_KEY=your_jsearch_api_key_here
JSEARCH_HOST=google-search-api1.p.rapidapi.com

# --- ChromaDB (local persistent path by default) ---
CHROMA_DB_PATH=./chroma_db

# --- CORS / Frontend URL ---
# Local dev:  http://localhost:3000
# Prod:       https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# --- Application ---
APP_NAME=CareerPilot
DEBUG=false
ENVIRONMENT=production